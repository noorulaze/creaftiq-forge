# ─── Firebase ────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Dev — use local Firebase emulator ───────────────────────
# Set to "true" to use local emulator instead of production
VITE_USE_EMULATOR=false

# ─── AI Mock mode ────────────────────────────────────────────
# These are set in Cloud Functions environment, not client env vars.
# To disable mock mode for deployed functions:
#   firebase functions:config:set gemini.mock=false
#   firebase functions:config:set gemini.api_key=YOUR_GEMINI_API_KEY
